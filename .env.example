# =========================================================================
# AI Investment Opportunity Agent — Environment Configuration Template
# Copy this file to `.env` for local development and provide real values
# via your environment / secret manager in every other environment.
# NEVER commit a real .env file.
# =========================================================================

# --- Application ---
APP_ENV=development                 # development | test | staging | production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata           # PoV is India/INR scoped
APP_DEFAULT_CURRENCY=INR
LOG_LEVEL=INFO

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# --- PostgreSQL ---
POSTGRES_DB=inversement_agent
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Message queue ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Security ---
SECRET_KEY=change-me
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_LIFETIME_HOURS=12

# --- LLM ---
# Provider/API keys are injected at runtime only. NEVER commit real keys.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# --- External data sources (India/INR PoV) ---
# Placeholder names; exact providers are selected during Technology Stack topic (Topic 7).
MARKET_DATA_PROVIDER=
NSE_API_ENDPOINT=
BSE_API_ENDPOINT=
NEWS_API_ENDPOINT=
NEWS_API_KEY=
DATA_FETCH_TIMEOUT_SECONDS=30
DATA_MAX_RETRIES=3

# --- Paper trading / brokerage sandbox ---
BROKER_SANDBOX_MODE=true             # MUST stay true until live-execution governance is separately approved
BROKER_API_ENDPOINT=
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Simulation ---
BACKTEST_INITIAL_CAPITAL=1000000
PAPER_INITIAL_CAPITAL=1000000
PAPER_TRADING_ENABLED=false

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Dashboard (if served by this app) ---
DASHBOARD_ENABLED=true